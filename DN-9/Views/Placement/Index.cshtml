@model List<Placement>
@{ViewData["Title"]="Placement Dashboard";var s=ViewBag.Stats;}
<h2>Placement Dashboard</h2>@if(TempData["Message"]!=null){<div class="success">@TempData["Message"]</div>}
<div class="cards"><div class="card">Total Students<strong>@s.Item1</strong></div><div class="card">Placed<strong>@s.Item2</strong></div><div class="card">Applied<strong>@s.Item3</strong></div><div class="card">Interview<strong>@s.Item4</strong></div><div class="card">Average Package<strong>@s.Item5.ToString("0.00") LPA</strong></div></div>
<form class="filter" method="get"><input name="search" value="@ViewBag.Search" placeholder="Search student, enrollment or company"/><select name="status"><option value="All">All Status</option>@foreach(var st in new[]{"Applied","Interview","Placed","Rejected"}){<option value="@st" selected="@(ViewBag.Status==st)">@st</option>}</select><button class="btn">Filter</button><a class="btn gray" href="/Placement/Index">Reset</a></form>
<p><a class="btn" href="/Placement/Create">Add Placement</a> <a class="btn secondary" href="/Placement/Report">Generate Report</a></p>
<table><thead><tr><th>ID</th><th>Student</th><th>Enrollment</th><th>Department</th><th>Company</th><th>Status</th><th>Package LPA</th><th>Actions</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Id</td><td>@p.StudentName</td><td>@p.EnrollmentNo</td><td>@p.Department</td><td>@p.CompanyName</td><td>@p.Status</td><td>@p.PackageLpa.ToString("0.00")</td><td><a href="/Placement/Details/@p.Id">Details</a> | <a href="/Placement/Edit/@p.Id">Edit</a> | <a href="/Placement/Delete/@p.Id">Delete</a></td></tr>}</tbody></table>