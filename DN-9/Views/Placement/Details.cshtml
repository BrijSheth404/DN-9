@model Placement
@{ViewData["Title"]="Placement Details";}
<h2>Placement Details</h2><table class="details"><tr><th>ID</th><td>@Model.Id</td></tr><tr><th>Student</th><td>@Model.StudentName</td></tr><tr><th>Enrollment</th><td>@Model.EnrollmentNo</td></tr><tr><th>Department</th><td>@Model.Department</td></tr><tr><th>Company</th><td>@Model.CompanyName</td></tr><tr><th>Status</th><td>@Model.Status</td></tr><tr><th>Package</th><td>@Model.PackageLpa.ToString("0.00") LPA</td></tr><tr><th>Email</th><td>@Model.Email</td></tr></table><a class="btn" href="/Placement/Edit/@Model.Id">Edit</a> <a class="btn gray" href="/Placement/Index">Back</a>